# Contact form email delivery (Resend)
# Create an API key at https://resend.com and verify ashvi.tech (or a subdomain).
RESEND_API_KEY=
# Must be a verified sender on your Resend domain, e.g. contact@ashvi.tech
CONTACT_FROM_EMAIL=contact@ashvi.tech
# Destination inbox
CONTACT_TO_EMAIL=hello@ashvi.tech

# Optional but required for production-grade shared rate limiting on Vercel
# https://upstash.com/ → Redis REST credentials
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
